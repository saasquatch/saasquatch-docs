        "fields": {
          "question": "Does Referral SaaSquatch offer volume discounts?",
          "answer": "Happily! Our Enterprise tier is available for larger more complex solutions. Email us at <a href=\"mailto:sales@saasquat.ch?subject=Enterprise%20Plans\">sales@saasquat.ch</a>."
