          "locale": "en-US"
        },
        "fields": {
          "question": "Does Referral SaaSquatch work with foreign currencies?",
          "answer": "Yes. We work with any currency that your subscription provider works with. We will charge you in USD at the conversion rate available to us on the day of your invoice."
        }
      },
