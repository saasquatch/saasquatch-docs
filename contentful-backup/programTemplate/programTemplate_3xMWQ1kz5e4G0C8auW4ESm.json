                          "cents"
                        ],
                        "type": "string",
                        "title": "What is the denomination of your revenue value?"
                      }
                    }
                  }
                ]
              },
              "refundWindow": {
                "oneOf": [
                  {
                    "properties": {
                      "refundWindow": {
                        "enum": [
                          0
                        ]
                      }
                    }
                  },
                  {
                    "properties": {
                      "duration": {
                        "type": "string",
                        "title": "Refund window duration:"
                      },
                      "refundEvent": {
                        "enum": [
                          false,
                          true
                        ],
                        "type": "boolean",
                        "title": "Whether or not to enable refunding based on an event"
                      },
                      "refundWindow": {
                        "enum": [
                          1
                        ]
                      }
                    },
                    "dependencies": {
                      "refundEvent": {
                        "oneOf": [
                          {
                            "properties": {
                              "refundEvent": {
                                "enum": [
                                  false
                                ]
                              }
                            }
                          },
                          {
                            "required": [
                              "refundEventKey",
                              "refundEventOrderId",
                              "purchaseEventOrderId"
                            ],
                            "properties": {
                              "refundEvent": {
                                "enum": [
                                  true
                                ]
                              },
                              "refundEventKey": {
                                "type": "string",
                                "title": "What event linked to the Influenced Customer will trigger the cancellation of a Partner's reward?"
                              },
                              "refundEventOrderId": {
                                "type": "string",
                                "title": "What refund event field holds the order ID?"
                              },
                              "purchaseEventOrderId": {
                                "type": "string",
                                "title": "What purchase event field holds the order ID?"
                              }
                            }
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            }
