                "default": 0,
                "enumNames": [
                  "Give rewards immediately",
                  "Delay rewards"
                ]
              },
              "revenueField": {
                "type": "string",
                "title": "What event field holds the value used to calculate commission rewards?"
              }
            },
            "dependencies": {
              "isDynamic": {
                "oneOf": [
                  {
                    "properties": {
                      "isDynamic": {
                        "enum": [
                          false
                        ]
                      }
                    }
                  },
                  {
                    "required": [
                      "defaultCurrency",
                      "currencyField",
                      "revenueDenomination"
                    ],
                    "properties": {
                      "isDynamic": {
                        "enum": [
                          true
                        ]
                      },
                      "currencyField": {
                        "type": "string",
                        "title": "What event field holds the currency?"
                      },
                      "defaultCurrency": {
