              "isDynamic",
              "eventKey",
              "revenueField"
            ],
            "properties": {
              "JSONata": {
                "type": "string",
                "title": "Enter Conversion Criteria"
              },
              "eventKey": {
                "type": "string",
                "title": "What event linked to the Influenced Customer will trigger a Partner reward?"
              },
              "isDynamic": {
                "enum": [
                  true,
                  false
