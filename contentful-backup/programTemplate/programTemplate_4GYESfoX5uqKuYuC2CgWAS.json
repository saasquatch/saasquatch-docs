  "fields": {
    "name": "Win Back",
    "icon": "sqtch-prgrm-winback",
    "categories": [
      "reactivate"
    ],
    "slug": "win-back-program",
    "summary": "Reactivate idle users with special offers.",
    "longDescription": "A win back program re-engages lapsed or quiet customers by offering a reward if they do a specific action, such as re-activating a subscription or completing a new purchase.\n\nThis can be used to target old customers who haven’t made a purchase in a certain number of days or months, people who expressed interest but never bought, or even those who have explicitly cancelled their subscription. \n\n### Example:\n\nA company that delivers groceries to customers on a weekly basis wants to increase revenue by ensuring that orders are consistent.\n\nThe company launches a win back program to send a $10 credit to a customer if they haven't placed an order in the last month.\n\n### Features:\n\n* Set the amount of time after last purchase/cancellation to reward a user.\n* Choose to reward customers one time or every time they haven’t purchased within your time frame.\n* Target specific customer segments.\n* Customize the email sent to users when their reward is ready to use.",
    "schema": {
      "name": "Win Back Program",
      "rules": {
        "type": "object",
        "title": "Program Rules",
        "$schema": "http://json-schema.org/draft-06/schema#",
        "required": [
          "inactiveDuration",
          "lastActionDateType"
        ],
        "properties": {
          "rewardRules": {
            "type": "object",
            "title": "Reward Rules",
            "required": [
              "recurring"
            ],
            "properties": {
              "recurring": {
                "enum": [
                  0,
                  1
                ],
                "type": "integer",
                "title": "Reward users:",
                "default": 0,
                "enumNames": [
                  "Once",
                  "Every time they meet the criteria"
                ]
              }
            }
          },
          "earliestDate": {
            "type": "string",
            "title": "Reward existing users who completed a purchase after this date"
          },
          "inactiveDuration": {
            "type": "string",
            "title": "Reward users this long after their last purchase or custom event"
          },
          "userSegmentation": {
            "type": "array",
