            }
          },
          "lastActionDateType": {
            "enum": [
              0,
              1
            ],
            "type": "integer",
            "title": "Evaluate users last activity based on:",
            "default": 0,
            "enumNames": [
              "Last purchase date",
              "Custom"
            ]
          }
        },
